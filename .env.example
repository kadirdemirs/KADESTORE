# === VERİTABANI (PostgreSQL - Neon.tech ücretsiz) ===
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# === NEXTAUTH ===
NEXTAUTH_SECRET="guclu-rastgele-secret-buraya-en-az-32-karakter"
NEXTAUTH_URL="https://kadestore.vercel.app"

# === E-POSTA (Gmail App Password) ===
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="email@gmail.com"
SMTP_PASS="xxxx-xxxx-xxxx-xxxx"
SMTP_FROM="KadeStore <email@gmail.com>"

# === SHOPIER ===
SHOPIER_API_KEY="shopier_api_key"
SHOPIER_API_SECRET="shopier_api_secret"
SHOPIER_WEBSITE_INDEX="1"
SHOPIER_API_TOKEN="shopier_jwt_token"

# === AYARLAR ===
LOW_STOCK_THRESHOLD="3"

# === İSTEĞE BAĞLI ENTEGRASYONLAR ===

# Sentry — hata izleme. Aktif etmek için:
#  1) sentry.io'da proje açın, DSN alın
#  2) npm i @sentry/nextjs && npx @sentry/wizard@latest -i nextjs
# SENTRY_DSN=""

# Upstash Redis — rate-limit ve cache. Aktif etmek için:
#  upstash.com'da Redis instance açın, REST URL ve token kopyalayın
# UPSTASH_REDIS_URL=""
# UPSTASH_REDIS_TOKEN=""

# Cloudinary — görsel upload (Vercel'de persist olur). Aktif etmek için:
#  cloudinary.com'da ücretsiz hesap açın
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# Plausible — KVKK uyumlu analitik. Aktif etmek için:
#  plausible.io'da domain ekleyin
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN="kadestore.com"

# Tawk.to — canlı destek widget. Aktif etmek için:
#  tawk.to'da ücretsiz hesap açın, dashboard > admin > chat widget
# NEXT_PUBLIC_TAWK_PROPERTY_ID=""
# NEXT_PUBLIC_TAWK_WIDGET_ID=""
